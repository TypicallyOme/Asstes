{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 20)",
        "avatar": { ".validate": "newData.isString() && newData.val().length < 1500000" },
        "bio": { ".validate": "newData.isString() && newData.val().length <= 160" }
      }
    },
    "names":    { ".read": true, ".write": true },
    "roles":    { ".read": true, ".write": true },
    "owners":   { ".read": true, ".write": true },
    "customTags": { ".read": true, ".write": true },
    "userTags": { ".read": true, ".write": true },
    "announcement": { ".read": true, ".write": true },
    "moreCards": { ".read": true, ".write": true },
    "communities": { ".read": true, ".write": true },
    "communityMsgs": { ".read": true, ".write": true },
    "communityTyping": { ".read": true, ".write": true },
    "mod":      { ".read": true, ".write": true },
    "presence": { ".read": true, "$uid": { ".write": true } },
    "typing":   { ".read": true, "$uid": { ".write": true } },
    "messages": {
      ".read": true,
      ".indexOn": ["ts"],
      "$id": {
        ".write": true,
        "text": { ".validate": "newData.isString() && newData.val().length <= 4000" }
      }
    },
    "posts": {
      ".read": true,
      ".indexOn": ["ts"],
      "$id": {
        ".write": true,
        "text": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "embed": {
          ".validate": "!newData.exists() || (newData.child('type').val() == 'url' && newData.child('url').isString() && newData.child('url').val().length <= 2048) || (newData.child('type').val() == 'html' && newData.child('html').isString() && newData.child('html').val().length <= 20000)"
        }
      }
    },
    "comments": {
      ".read": true,
      "$postId": {
        "$id": {
          ".write": true,
          "text": { ".validate": "newData.isString() && newData.val().length <= 1000" }
        }
      }
    },
    "convs":      { ".read": true, ".write": true },
    "convMsgs":   { ".read": true, ".write": true },
    "convTyping": { ".read": true, ".write": true },
    "userConvs":  { ".read": true, ".write": true },
    "reads":      { ".read": true, ".write": true },
    "files": {
      ".read": true,
      "$id": {
        ".write": true,
        "data": { ".validate": "newData.isString() && newData.val().length < 13500000" }
      }
    }
  }
}
