{
  "rules": {
    "users": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 20)",
        "avatar": { ".validate": "newData.isString() && newData.val().length < 1500000" },
        "bio": { ".validate": "newData.isString() && newData.val().length <= 160" }
      }
    },
    "names":    { ".read": true, ".write": true },
    "roles":    { ".read": true, ".write": "auth != null && auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2'" },
    "owners":   { ".read": true, ".write": "auth != null && auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2'" },
    "adminAuthUids": {
      "$authUid": {
        ".read": "auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.uid === $authUid)",
        ".write": "auth != null && auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2'",
        ".validate": "!newData.exists() || (newData.isString() && root.child('roles').child(newData.val()).val() === 'admin')"
      }
    },
    "adminAuthByProfile": {
      "$profileId": {
        ".read": "auth != null && auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2'",
        ".write": "auth != null && auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2'"
      }
    },
    "customTags": { ".read": true, ".write": "auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.token.admin === true || root.child('adminAuthUids').child(auth.uid).exists())" },
    "userTags": { ".read": true, ".write": "auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.token.admin === true || root.child('adminAuthUids').child(auth.uid).exists())" },
    "announcement": { ".read": true, ".write": "auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.token.admin === true || root.child('adminAuthUids').child(auth.uid).exists())" },
    "publicSettings": { ".read": true, ".write": "auth != null && auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2'" },
    "chatSettings": { ".read": true, ".write": "auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.token.admin === true || root.child('adminAuthUids').child(auth.uid).exists())" },
    "moreCards": { ".read": true, ".write": true },
    "communities": { ".read": true, ".write": true },
    "communityMsgs": { ".read": true, ".write": true },
    "communityTyping": { ".read": true, ".write": true },
    "channelMessages": {
      ".read": true,
      "$channel": {
        ".indexOn": ["ts"],
        "$id": {
          ".write": "(!data.exists() && $channel === 'anonymous' && root.child('chatSettings').child('lockdown').val() !== true && newData.child('uid').isString() && newData.child('uid').val().matches(/^[A-Za-z0-9_-]{8,40}$/) && root.child('users').child(newData.child('uid').val()).exists() && root.child('mod').child(newData.child('uid').val()).child('banned').val() !== true && (!root.child('mod').child(newData.child('uid').val()).child('timeoutUntil').exists() || root.child('mod').child(newData.child('uid').val()).child('timeoutUntil').val() <= now)) || (auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.token.admin === true || root.child('adminAuthUids').child(auth.uid).exists()))",
          "reactions": { ".write": true },
          "ts": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 4000" }
        }
      }
    },
    "channelTyping": { ".read": true, "$channel": { ".read": true, "$uid": { ".write": true } } },
    "omeglePool": { ".read": true, ".write": true },
    "omegleSessions": { ".read": true, ".write": true },
    "omegleRooms": {
      ".read": true,
      "$room": {
        ".indexOn": ["ts"],
        "$id": {
          ".write": "(!data.exists() && root.child('chatSettings').child('lockdown').val() !== true && newData.child('uid').isString() && newData.child('uid').val().matches(/^[A-Za-z0-9_-]{8,40}$/) && root.child('users').child(newData.child('uid').val()).exists() && root.child('omegleSessions').child($room).child('members').child(newData.child('uid').val()).val() === true && root.child('mod').child(newData.child('uid').val()).child('banned').val() !== true && (!root.child('mod').child(newData.child('uid').val()).child('timeoutUntil').exists() || root.child('mod').child(newData.child('uid').val()).child('timeoutUntil').val() <= now)) || (auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.token.admin === true || root.child('adminAuthUids').child(auth.uid).exists()))",
          "reactions": { ".write": true },
          "ts": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000" },
          "text": { ".validate": "newData.isString() && newData.val().length <= 4000" }
        }
      }
    },
    "omegleTyping": { ".read": true, "$room": { ".read": true, "$uid": { ".write": true } }},
    "mod":      { ".read": true, ".write": "auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.token.admin === true || root.child('adminAuthUids').child(auth.uid).exists())" },
    "presence": { ".read": true, "$uid": { ".write": true } },
    "presenceSessions": { ".read": true, "$uid": { ".write": true } },
    "typing":   { ".read": true, "$uid": { ".write": true } },
    "messages": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2'",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "(!data.exists() && root.child('chatSettings').child('lockdown').val() !== true && newData.child('uid').isString() && newData.child('uid').val().matches(/^[A-Za-z0-9_-]{8,40}$/) && root.child('users').child(newData.child('uid').val()).exists() && root.child('mod').child(newData.child('uid').val()).child('banned').val() !== true && (!root.child('mod').child(newData.child('uid').val()).child('timeoutUntil').exists() || root.child('mod').child(newData.child('uid').val()).child('timeoutUntil').val() <= now)) || (auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.token.admin === true || root.child('adminAuthUids').child(auth.uid).exists()))",
        "reactions": { ".write": true },
        "ts": { ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000" },
        "text": { ".validate": "newData.isString() && newData.val().length <= 4000" }
      }
    },
    "posts": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2'",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "!data.exists() || (auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.token.admin === true || root.child('adminAuthUids').child(auth.uid).exists()))",
        "reactions": { ".write": true },
        "text": { ".validate": "newData.isString() && newData.val().length <= 5000" },
        "embed": {
          ".validate": "!newData.exists() || (newData.child('type').val() == 'url' && newData.child('url').isString() && newData.child('url').val().length <= 2048) || (newData.child('type').val() == 'html' && newData.child('html').isString() && newData.child('html').val().length <= 20000)"
        }
      }
    },
    "comments": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2'",
      "$postId": {
        "$id": {
          ".write": "!data.exists() || (auth != null && (auth.uid === 'zdvC4quVlRSabq57SDXoukS7SAt2' || auth.token.admin === true || root.child('adminAuthUids').child(auth.uid).exists()))",
          "reactions": { ".write": true },
          "text": { ".validate": "newData.isString() && newData.val().length <= 1000" }
        }
      }
    },
    "convs":      { ".read": true, ".write": true },
    "convMsgs":   { ".read": true, ".write": true },
    "convTyping": { ".read": true, ".write": true },
    "userConvs":  { ".read": true, ".write": true },
    "reads":      { ".read": true, ".write": true },
    "files": {
      ".read": true,
      "$id": {
        ".write": true,
        "data": { ".validate": "newData.isString() && newData.val().length < 13500000" }
      }
    }
  }
}
